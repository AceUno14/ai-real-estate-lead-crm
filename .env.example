# AI Real Estate Lead CRM
#
# Copy this file to .env.local for local development.
# Never put real secrets in .env.example.
# Never commit .env.local.

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

APP_NAME="AI Real Estate Lead CRM"

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# PostgreSQL / Neon connection string

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional direct database connection for migrations if required

DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

# Exact variable names may change after the authentication
# library is selected.

AUTH_SECRET="replace-with-a-long-random-secret"

AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# RUNTIME AI
# ------------------------------------------------------------

# The coding AI used to build this application is separate from
# the runtime AI used by the deployed CRM.
#
# Start development using the mock provider.

AI_PROVIDER="mock"

AI_MODEL="mock-real-estate-qualifier-v1"

# Used later for an OpenAI-compatible AI provider.

AI_API_KEY=""

AI_BASE_URL=""

AI_TIMEOUT_MS="30000"

# ------------------------------------------------------------
# PUBLIC LEAD CAPTURE
# ------------------------------------------------------------

# Public lead capture is workspace-specific: /lead/[organizationSlug].
# Each organization's form resolves its own organization server-side.
#
# This optional variable only sets the default workspace used by the
# legacy /lead route, which redirects to /lead/<slug>. It is never used
# to route a submission that already names a workspace in the URL.

PUBLIC_LEAD_ORG_SLUG="demo-realty"

# ------------------------------------------------------------
# OPTIONAL FUTURE EMAIL INTEGRATION
# ------------------------------------------------------------

# RESEND_API_KEY=""

# EMAIL_FROM=""

# ------------------------------------------------------------
# OPTIONAL FUTURE SMS INTEGRATION
# ------------------------------------------------------------

# TWILIO_ACCOUNT_SID=""

# TWILIO_AUTH_TOKEN=""

# TWILIO_PHONE_NUMBER=""